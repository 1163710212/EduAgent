# ===== LLM =====
# 默认对接本地 Ollama(OpenAI-compatible): llama3
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3
# Structured 输出格式校验失败时重试轮数（0 表示无限重试，直到返回符合 schema）
LLM_STRUCTURED_MAX_RETRY_CYCLES=0

# ===== GitHub MCP (Remote hosted) =====
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_PAT=ghp_your_pat_here

# toolsets: 默认只开 repos（够拉代码 + search_code）
GITHUB_MCP_TOOLSETS=repos
GITHUB_MCP_READONLY=true

# ===== App =====
APP_DB_PATH=/data/app.db
CORS_ALLOW_ORIGINS=*
